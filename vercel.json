{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/agents/quickstart.md",
      "destination": "/agents/quickstart.md"
    },
    {
      "source": "/colab_robotics_worker.ipynb",
      "destination": "/colab_robotics_worker.ipynb"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/v1?path=:path*"
    }
  ]
}
